{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "project-overview",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "projects.example.com", "custom_domain": true }],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 },
  },
  // Placeholders: Deploy fills these and the route from repository variables
  // (.github/scripts/deployment-config.mjs). Local runs use wrangler.local.jsonc.
  "vars": {
    "PORTFOLIO_ID": "owner",
    "SITE_URL": "https://projects.example.com",
    "BROWSER_HOSTS": "projects.example.com",
    "BROWSER_SIGN_IN": "",
    "OWNER_EMAIL": "owner@example.com",
    "EMAIL_FROM": "projects@notify.example.com",
    "TIME_ZONE": "UTC",
  },
  // Weekly upkeep (worker/upkeep.ts); src/upkeep-model.ts names the same schedule.
  "triggers": { "crons": ["0 18 * * 5", "30 * * * *"] },
  "browser": { "binding": "BROWSER" },
  "send_email": [{ "name": "EMAIL" }],
  "secrets": {
    "required": ["ALLOWED_EMAILS", "VAPID_PRIVATE_KEY"],
  },
  "durable_objects": {
    "code_update_strategy": { "mode": "immediate" },
    "bindings": [
      { "name": "PORTFOLIOS", "class_name": "Portfolio" },
      { "name": "CONVERSATIONS", "class_name": "Conversation" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Portfolio"] },
    { "tag": "v2", "new_sqlite_classes": ["Conversation"] },
  ],
}
