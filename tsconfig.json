{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "@cloudflare/workers-types"]
  },
  "include": [
    "src",
    "worker",
    "collector",
    "tests",
    "worker-configuration.d.ts",
    "vite.config.ts",
    "hooks",
    "runner",
    "scripts"
  ]
}
